# data/, models/, outputs/, and references/ are versioned — the clone ships with
# imagery, weights, and papers. Only these stay out:

# sample results duplicated from outputs/
/assets/

# training checkpoints — config, metrics, and notes under runs/ stay versioned
/runs/*/weights/

# pipeline stages rebuild from data/raw with scripts/run_pipeline.py, so only the
# raw archive is versioned. The per-stage CSVs stay: they are the lineage from a
# final filename back to the raw one, and cannot be recovered from the images.
/data/renamed/*
/data/no_dups/*
/data/quality_check/*
/data/un_annotated/*
!/data/*/*.csv

# python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.env

# editors / agent config
.vscode/
.idea/
CLAUDE.md

# macos
.DS_Store
